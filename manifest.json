{
  "manifest_version": 3,
  "name": "SpamGuard – AI-assisted Phishing Filter",
  "version": "0.9.3",
  "description": "ヘッダ構造のルールでフィッシング／迷惑メールを判定し、迷うメールだけ TypeSafe の Jev（任意）に問い合わせます。TypeSafe の公式製品ではありません。",
  "browser_specific_settings": {
    "gecko": {
      "id": "spamguard@helicon1968.github.io",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "accountsRead",
    "messagesRead",
    "messagesMove",
    "messagesUpdate",
    "messagesTags",
    "messagesTagsList",
    "menus",
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "https://api.typesafe.ai/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "action": {
    "default_title": "SpamGuard",
    "default_popup": "ui/popup.html",
    "default_icon": {
      "32": "icons/icon.svg"
    }
  },
  "options_ui": {
    "page": "ui/options.html",
    "open_in_tab": true
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  }
}
